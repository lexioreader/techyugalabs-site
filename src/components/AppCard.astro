---
import type { App } from '~/consts';

interface Props {
  app: App;
}

const { app } = Astro.props;
---

<a href={`/apps/${app.slug}/`} class="card" style={`--card-accent: ${app.accentColor}`}>
  <div class="card-head">
    <span class="dot" aria-hidden="true"></span>
    <span class="status">{app.status === 'live' ? 'Live' : 'In development'}</span>
  </div>

  <h3 class="name">{app.name}</h3>
  <p class="tagline">{app.tagline}</p>
  <p class="description">{app.description}</p>

  <div class="meta">
    <div class="platforms">
      {app.platforms.map((p) => <span class="platform">{p === 'android' ? 'Android' : p}</span>)}
    </div>
    <span class="arrow" aria-hidden="true">→</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    padding: 2rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    color: inherit;
    text-decoration: none;
    transition: transform 200ms ease, border-color 200ms ease, box-shadow 200ms ease;
    position: relative;
    overflow: hidden;
  }

  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 100% 0%,
      color-mix(in oklab, var(--card-accent) 10%, transparent),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 250ms ease;
    pointer-events: none;
  }

  .card:hover {
    transform: translateY(-2px);
    border-color: color-mix(in oklab, var(--card-accent) 40%, var(--color-border));
    box-shadow: var(--shadow-lg);
  }

  .card:hover::before { opacity: 1; }

  .card-head {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--card-accent);
    box-shadow: 0 0 10px var(--card-accent);
  }

  .name {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 0.375rem;
    letter-spacing: -0.015em;
  }

  .tagline {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-gold-400);
    margin: 0 0 1rem;
    font-size: var(--text-lg);
  }

  .description {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    flex: 1;
    margin: 0 0 1.5rem;
  }

  .meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1.25rem;
    border-top: 1px solid var(--color-border);
  }

  .platforms {
    display: flex;
    gap: 0.5rem;
  }

  .platform {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    padding: 0.25rem 0.5rem;
    background: var(--color-ink-800);
    border-radius: var(--radius-sm);
  }

  .arrow {
    color: var(--color-gold-400);
    font-size: 1.125rem;
    transition: transform 200ms ease;
  }

  .card:hover .arrow { transform: translateX(4px); }
</style>
