---
import { AUTHOR } from '~/consts';

const handles = Object.entries(AUTHOR.handles).filter(([, url]) => !!url);
---

<aside class="author-bio" aria-label={`About ${AUTHOR.name}`}>
  {
    AUTHOR.avatar && (
      <img
        src={AUTHOR.avatar}
        alt={AUTHOR.name}
        class="avatar"
        width="64"
        height="64"
        loading="lazy"
      />
    )
  }
  <div class="body">
    <p class="meta">Written by</p>
    <p class="name">
      <a href="/about/#author">{AUTHOR.name}</a>
      <span class="role">· {AUTHOR.role}</span>
    </p>
    <p class="bio">{AUTHOR.bio}</p>
    {
      handles.length > 0 && (
        <ul class="handles">
          {handles.map(([key, url]) => (
            <li>
              <a href={url} rel="me noopener author" target="_blank">
                {key === 'x' ? 'X' : key.charAt(0).toUpperCase() + key.slice(1)}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</aside>

<style>
  .author-bio {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    margin: 3rem 0 2rem;
  }

  .avatar {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
  }

  .body { flex: 1; min-width: 0; }

  .meta {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin: 0 0 0.375rem;
  }

  .name {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text);
    margin: 0 0 0.5rem;
    font-weight: 500;
  }

  .name a {
    color: inherit;
    text-decoration: none;
  }
  .name a:hover { color: var(--color-gold-400); }

  .role {
    color: var(--color-text-dim);
    font-size: var(--text-sm);
    font-style: italic;
    font-weight: 400;
    font-family: var(--font-sans);
  }

  .bio {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.55;
    margin: 0 0 0.75rem;
  }

  .handles {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .handles a {
    display: inline-block;
    padding: 0.2rem 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-gold-400);
    background: var(--color-ink-800);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    text-decoration: none;
    transition: border-color 120ms ease, color 120ms ease;
  }

  .handles a:hover {
    border-color: var(--color-gold-500);
    color: var(--color-gold-300);
  }

  @media (max-width: 480px) {
    .author-bio { flex-direction: column; }
  }
</style>
