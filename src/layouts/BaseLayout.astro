---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import SeoHead from '~/components/SeoHead.astro';
import Analytics from '~/components/Analytics.astro';

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  noindex?: boolean;
  // JSON-LD structured data to inject (Article, BreadcrumbList, etc).
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType = 'website',
  publishedTime,
  modifiedTime,
  noindex = false,
  structuredData,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- FOUC-prevention for theme. Runs BEFORE CSS loads to set the .dark
         class based on saved preference or system setting. Must be inline
         and synchronous. Mirrored in ThemeToggle.astro — keep in sync. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('tsl-theme');
          var systemDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          var dark = stored === 'dark' || (stored === null && systemDark);
          if (dark) document.documentElement.classList.add('dark');
        } catch (_) { /* storage disabled; default light */ }
      })();
    </script>
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      publishedTime={publishedTime}
      modifiedTime={modifiedTime}
      noindex={noindex}
      structuredData={structuredData}
    />
    <Analytics />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <style>
      .skip-link {
        position: absolute;
        top: -40px;
        left: 0.5rem;
        background: var(--color-gold-500);
        color: var(--color-ink-950);
        padding: 0.5rem 1rem;
        border-radius: var(--radius);
        font-weight: 600;
        z-index: 100;
        transition: top 150ms ease;
      }
      .skip-link:focus { top: 0.5rem; }

      main { min-height: calc(100vh - 20rem); }
    </style>
  </body>
</html>
