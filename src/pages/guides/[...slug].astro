---
import { getCollection, render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import AuthorBio from '~/components/AuthorBio.astro';
import { CATEGORIES, SITE_NAME, SITE_URL, AUTHOR, authorSameAs } from '~/consts';

export async function getStaticPaths() {
  const guides = await getCollection('guides', (g) => !g.data.draft);
  return guides.map((guide) => ({
    params: { slug: guide.id },
    props: { guide },
  }));
}

const { guide } = Astro.props;
const { Content, headings } = await render(guide);

const categoryMeta = CATEGORIES.find((c) => c.slug === guide.data.category);
const dateFormatter = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

// Author on the Article schema is a Person (not an Organization) — this is
// what Google's E-E-A-T guidelines expect. The sameAs array ties this
// author to their verifiable social profiles across the web.
const guideAuthorName = guide.data.author ?? AUTHOR.name;
const isHouseAuthor = guideAuthorName === AUTHOR.name;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: guide.data.title,
  description: guide.data.description,
  datePublished: guide.data.pubDate.toISOString(),
  dateModified: (guide.data.updatedDate ?? guide.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: guideAuthorName,
    ...(isHouseAuthor && {
      url: new URL(AUTHOR.url, SITE_URL).href,
      jobTitle: AUTHOR.role,
      sameAs: authorSameAs(),
    }),
  },
  publisher: {
    '@type': 'Organization',
    name: SITE_NAME,
    url: SITE_URL,
    ...(AUTHOR.avatar && {
      logo: {
        '@type': 'ImageObject',
        url: new URL(AUTHOR.avatar, SITE_URL).href,
      },
    }),
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(`/guides/${guide.id}/`, SITE_URL).href,
  },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: new URL('/guides/', SITE_URL).href },
    {
      '@type': 'ListItem',
      position: 3,
      name: guide.data.title,
      item: new URL(`/guides/${guide.id}/`, SITE_URL).href,
    },
  ],
};

// Only show top-level (h2) headings in the table of contents.
const tocHeadings = headings.filter((h) => h.depth === 2);
---

<BaseLayout
  title={guide.data.title}
  description={guide.data.description}
  canonical={`/guides/${guide.id}`}
  ogType="article"
  publishedTime={guide.data.pubDate}
  modifiedTime={guide.data.updatedDate}
  structuredData={[articleSchema, breadcrumbSchema]}
>
  <article>
    <header class="guide-header">
      <div class="container narrow">
        <nav class="breadcrumb" aria-label="Breadcrumb">
          <ol>
            <li><a href="/">Home</a></li>
            <li aria-hidden="true">/</li>
            <li><a href="/guides/">Writing</a></li>
            {
              categoryMeta && (
                <>
                  <li aria-hidden="true">/</li>
                  <li>{categoryMeta.name}</li>
                </>
              )
            }
          </ol>
        </nav>

        <h1>{guide.data.title}</h1>
        <p class="description">{guide.data.description}</p>

        <div class="meta">
          <time datetime={guide.data.pubDate.toISOString()}>{dateFormatter.format(guide.data.pubDate)}</time>
          {
            guide.data.updatedDate && (
              <span class="updated">
                · Updated <time datetime={guide.data.updatedDate.toISOString()}>{dateFormatter.format(guide.data.updatedDate)}</time>
              </span>
            )
          }
          <span class="dot-sep" aria-hidden="true">·</span>
          {
            isHouseAuthor ? (
              <a href="/about/#author" class="author-link" rel="author">{guideAuthorName}</a>
            ) : (
              <span>{guideAuthorName}</span>
            )
          }
        </div>
      </div>
    </header>

    <div class="container narrow">
      <div class="guide-layout">
        {
          tocHeadings.length > 2 && (
            <aside class="toc" aria-label="Table of contents">
              <p class="toc-title">On this page</p>
              <ol>
                {tocHeadings.map((h) => (
                  <li><a href={`#${h.slug}`}>{h.text}</a></li>
                ))}
              </ol>
            </aside>
          )
        }

        <div class="prose guide-body">
          <Content />
          {isHouseAuthor && <AuthorBio />}
        </div>
      </div>

      {
        guide.data.appCta === 'pagesage' && (
          <aside class="app-cta">
            <div class="cta-inner">
              <p class="cta-eyebrow">The app this guide is about</p>
              <h3>ReadYuga</h3>
              <p>The offline AI ebook reader. No subscription. No cloud.</p>
              <a href="/apps/pagesage/" class="cta-link">Learn more →</a>
            </div>
          </aside>
        )
      }
    </div>
  </article>
</BaseLayout>

<style>
  .container {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  .container.narrow { max-width: 56rem; }

  .guide-header {
    padding: 4rem 0 3rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  @media (max-width: 640px) {
    .guide-header { padding: 2rem 0 1.5rem; margin-bottom: 2rem; }
    .guide-header h1 { font-size: var(--text-3xl); }
    .guide-header .lead { font-size: var(--text-base); }
    /* Breadcrumb goes to a single compact line with smaller slashes. */
    .breadcrumb ol { flex-wrap: wrap; gap: 0.25rem; margin-bottom: 1rem; }
  }

  .breadcrumb ol {
    display: flex;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
    font-size: var(--text-xs);
    color: var(--color-text-dim);
  }

  .breadcrumb a {
    color: var(--color-text-dim);
    text-decoration: none;
  }
  .breadcrumb a:hover { color: var(--color-gold-400); }

  .guide-header h1 {
    font-family: var(--font-serif);
    font-size: var(--text-4xl);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin: 0 0 1rem;
  }

  .guide-header .description {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.55;
    margin: 0 0 1.5rem;
    max-width: 60ch;
  }

  .meta {
    font-size: var(--text-xs);
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
  }

  .dot-sep { margin: 0 0.5rem; }
  .updated { color: var(--color-text-dim); }

  .author-link {
    color: var(--color-gold-400);
    text-decoration: none;
    transition: color 120ms ease;
  }
  .author-link:hover { color: var(--color-gold-300); }

  .guide-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }

  /* Hide the TOC sidebar on mobile/tablet. At 360-640 px the TOC was
     landing above the article body (markup order + single-column grid)
     and eating the critical first screenful. Users scan the guide on
     phones; the on-page section headers already serve as orientation. */
  @media (max-width: 959px) {
    .toc { display: none; }
  }

  @media (min-width: 960px) {
    .guide-layout {
      grid-template-columns: 1fr 200px;
      gap: 4rem;
    }
    .toc { order: 2; }
    .guide-body { order: 1; }
  }

  .toc {
    position: sticky;
    top: 5rem;
    align-self: start;
    border-left: 1px solid var(--color-border);
    padding-left: 1rem;
  }

  .toc-title {
    font-size: 0.75rem;
    color: var(--color-text-dim);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-weight: 600;
    margin: 0 0 1rem;
  }

  .toc ol {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .toc a {
    color: var(--color-text-dim);
    text-decoration: none;
    font-size: var(--text-xs);
    line-height: 1.4;
    display: block;
  }

  .toc a:hover { color: var(--color-gold-400); }

  /* In-app CTA at bottom of guide */
  .app-cta {
    margin: 4rem 0 2rem;
    padding: 2rem;
    background: linear-gradient(135deg, var(--color-ink-900), var(--color-ink-800));
    border: 1px solid color-mix(in oklab, var(--color-gold-500) 20%, var(--color-border));
    border-radius: var(--radius-lg);
  }

  .cta-eyebrow {
    font-size: var(--text-xs);
    color: var(--color-gold-400);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin: 0 0 0.5rem;
  }

  .app-cta h3 {
    font-family: var(--font-serif);
    font-size: var(--text-2xl);
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 0.375rem;
  }

  .app-cta p {
    color: var(--color-text-muted);
    margin: 0 0 1rem;
  }

  .cta-link {
    color: var(--color-gold-400);
    text-decoration: none;
    font-weight: 500;
  }
  .cta-link:hover { color: var(--color-gold-300); }
</style>
