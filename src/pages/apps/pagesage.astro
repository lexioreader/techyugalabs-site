---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE_URL, APPS } from '~/consts';

const app = APPS.find((a) => a.slug === 'pagesage')!;

const features = [
  {
    title: 'Reads PDFs and EPUBs',
    body:
      'PDF and EPUB, including scanned PDFs with no selectable text. The on-device OCR kicks in only when a page needs it, silently in the background.',
  },
  {
    title: 'Offline AI, not cloud AI',
    body:
      'Summarize a chapter, ask a question about the page, translate a word: all on your device. Nothing is uploaded, nothing is logged, nothing trains anyone else\'s model.',
  },
  {
    title: 'Dictionary and translation for dozens of languages',
    body:
      'Tap a word. Get the definition first, translation as fallback. Offline dictionary for English, with Wiktionary packs for Portuguese, Spanish, Indonesian, German, and Korean. No data fees on a plane or a hike.',
  },
  {
    title: 'Neural narration',
    body:
      'High-quality on-device voices (Lessac, Amy, Ryan) that turn a PDF into a listenable book. No streaming latency, no quota, no account.',
  },
  {
    title: 'Focus Beam and themed modes',
    body:
      'Four free themes (Classic, Sepia, Dark, Lamp). Focus Beam dims the page around what you\'re reading. Reflow mode reshapes a textbook PDF into something that fits a phone screen.',
  },
  {
    title: 'Pay once. Keep forever.',
    body:
      'No subscription. A single one-time ReadYuga Pro unlock covers every paid feature (on-device AI, neural voices, premium themes, and more). Your copy is yours.',
  },
];

const principles = [
  { label: 'No account', body: 'No sign-up. The app opens to your books.' },
  { label: 'No ads', body: 'Ever. The app is the product.' },
  { label: 'No tracking', body: 'Anonymous crash + usage telemetry only. No per-user profile.' },
  { label: 'No cloud sync we didn\'t ask for', body: 'Sync is BYO-cloud (Obsidian/Joplin pattern), not a server we run.' },
];

const faq = [
  {
    q: 'Does ReadYuga work without internet?',
    a: 'Yes. Reading, AI features (after the on-device model installs), TTS (after neural voice install), dictionary, and translation all work fully offline. The only network-touching thing is the Play Store listing and the one-time downloads for the AI model and neural voices.',
  },
  {
    q: 'Is the AI any good?',
    a: 'It runs Qwen 3 on-device for chapter summaries, page Q&A, key points, and contextual word meanings. It won\'t replace GPT-4, but for reading-adjacent tasks on a book you already have, it\'s more useful than it is impressive.',
  },
  {
    q: 'How big is the download?',
    a: 'The app itself is small. The on-device AI model is 1 to 2 GB depending on your device and downloads once on first use. Neural narrator voices are 50 to 80 MB each, downloaded only when you pick one.',
  },
  {
    q: 'Does it support non-English books?',
    a: 'Yes. The dictionary ships English (WordNet) plus Wiktionary StarDicts for Portuguese, Spanish, Indonesian, German, and Korean. Translation covers 100+ language pairs via Google ML Kit. AI responses work natively for English, Spanish, French, German, Arabic, Japanese, Korean, and Chinese; other languages roundtrip through English.',
  },
  {
    q: 'Is there an iPhone version?',
    a: 'Not yet. iOS is on the long-term roadmap but Android ships first.',
  },
];

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'ReadYuga',
  operatingSystem: 'Android',
  applicationCategory: 'BookApplication',
  description: app.description,
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
  },
  aggregateRating: undefined,
};
---

<BaseLayout
  title="ReadYuga: the offline AI ebook reader"
  description={app.description}
  canonical="/apps/pagesage/"
  structuredData={articleSchema}
>
  <section class="hero">
    <div class="container">
      <div class="hero-grid">
        <div class="hero-text">
          <p class="eyebrow">
            <span class="dot" aria-hidden="true"></span> ReadYuga · Android
          </p>
          <h1>The offline AI ebook reader for people who read deeply.</h1>
          <p class="lead">
            PDFs, EPUBs, and scanned PDFs, read with AI that lives on your device.
            No subscription. No cloud. No account. Your library stays yours.
          </p>

          <div class="cta-row">
            <a href={app.storeUrl} class="btn primary" rel="noopener">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M3 20.5V3.5c0-.58.3-1.07.75-1.35L13.19 12 3.75 21.85c-.45-.28-.75-.78-.75-1.35m14.54-6.97l-3.1 1.75-2.78-2.28 2.78-2.28 3.1 1.75c.99.56.99 1.5 0 2.06M15.5 8.66l-9.26 5.24 7.7-7.33 1.56 2.09m-7.7 11.51l9.26 5.24-1.56 2.09-7.7-7.33" />
              </svg>
              Get on Google Play
            </a>
            <a href="/guides/" class="btn ghost">Read the guides →</a>
          </div>

          <ul class="trust-row">
            {principles.map((p) => (
              <li>
                <strong>{p.label}.</strong> {p.body}
              </li>
            ))}
          </ul>
        </div>

        <div class="hero-visual" aria-hidden="true">
          <div class="phone-frame">
            <div class="phone-screen">
              <div class="chapter-label">Chapter 7</div>
              <h3 class="page-title">The Weight of Attention</h3>
              <div class="page-text">
                <p>In the span of a human lifetime, the attention we give to any single thing has become, quietly and then all at once, the most valuable currency we have.</p>
                <p>What used to be given freely is now rationed: parcelled out between inboxes, notifications, headlines, and the ambient dread of the next thing to look at.</p>
              </div>
              <div class="ai-chip">
                <span class="ai-dot"></span>
                AI · Summarizing on-device
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="features">
    <div class="container">
      <header class="section-head">
        <h2>What's inside</h2>
        <p>Six features that justify the download; many smaller ones that reward using it daily.</p>
      </header>

      <div class="features-grid">
        {features.map((f) => (
          <div class="feature">
            <h3>{f.title}</h3>
            <p>{f.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="faq">
    <div class="container">
      <header class="section-head">
        <h2>Questions people ask</h2>
      </header>

      <div class="faq-list">
        {faq.map((item) => (
          <details>
            <summary>{item.q}</summary>
            <p>{item.a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="container">
      <div class="cta-card">
        <h2>A reading app that doesn't want your attention, only your reading time.</h2>
        <a href={app.storeUrl} class="btn primary large" rel="noopener">Get ReadYuga on Google Play</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .container {
    max-width: var(--container-wide);
    margin: 0 auto;
    padding: 0 1.5rem;
  }

  /* Hero */
  .hero {
    padding: 5rem 0 4rem;
    position: relative;
    overflow: hidden;
  }

  .hero::before {
    content: '';
    position: absolute;
    top: -20%;
    right: -10%;
    width: 600px;
    height: 600px;
    background: radial-gradient(
      circle,
      color-mix(in oklab, var(--color-gold-500) 12%, transparent),
      transparent 60%
    );
    pointer-events: none;
    z-index: -1;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 4rem;
    align-items: center;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-xs);
    color: var(--color-gold-400);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    margin: 0 0 1.25rem;
    padding: 0.375rem 0.75rem;
    border: 1px solid color-mix(in oklab, var(--color-gold-500) 30%, transparent);
    border-radius: 100px;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-gold-500);
    box-shadow: 0 0 8px var(--color-gold-500);
  }

  .hero h1 {
    font-family: var(--font-serif);
    font-size: var(--text-5xl);
    font-weight: 400;
    color: var(--color-text);
    letter-spacing: -0.025em;
    line-height: 1.08;
    margin: 0 0 1.5rem;
  }

  .lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
    line-height: 1.6;
    margin: 0 0 2rem;
  }

  .cta-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem; }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1.5rem;
    font-size: var(--text-sm);
    font-weight: 500;
    border-radius: var(--radius);
    text-decoration: none;
    transition: transform 150ms ease, background-color 150ms ease, color 150ms ease, box-shadow 150ms ease;
  }

  .btn.large { padding: 1.125rem 2rem; font-size: var(--text-base); }

  .btn.primary {
    background: var(--color-gold-500);
    color: var(--color-ink-950);
  }
  .btn.primary:hover {
    background: var(--color-gold-400);
    transform: translateY(-1px);
    box-shadow: 0 8px 20px -6px color-mix(in oklab, var(--color-gold-500) 50%, transparent);
  }

  .btn.ghost {
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .btn.ghost:hover { border-color: var(--color-gold-500); color: var(--color-gold-400); }

  .trust-row {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
  }

  .trust-row li {
    color: var(--color-text-dim);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  .trust-row strong { color: var(--color-text); font-weight: 600; }

  /* Hero visual — CSS illustration (no image dependency yet) */
  .hero-visual { display: flex; justify-content: center; }

  /* Phone mockup: deliberately locked to dark values regardless of the page
     theme. It's a product asset representing "ReadYuga showing a book in
     reading mode"; swapping its colors with the theme would make it fade
     into the page in light mode. */
  .phone-frame {
    width: 280px;
    aspect-ratio: 9 / 19;
    background: linear-gradient(180deg, #1a2235, #0f1522);
    border: 1px solid #2a3449;
    border-radius: 2rem;
    padding: 0.75rem;
    box-shadow:
      0 40px 80px -20px rgb(0 0 0 / 0.5),
      0 0 0 1px rgb(200 165 107 / 0.12);
    position: relative;
  }

  .phone-screen {
    height: 100%;
    background: #0a0e1a;
    border-radius: 1.5rem;
    padding: 1.5rem 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    overflow: hidden;
    position: relative;
  }

  .chapter-label {
    font-size: 0.7rem;
    color: #d9bc8a;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 600;
    text-align: center;
  }

  .page-title {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    color: #eef0f6;
    text-align: center;
    margin: 0 0 0.75rem;
    letter-spacing: -0.01em;
  }

  .page-text p {
    font-family: var(--font-serif);
    font-size: 0.75rem;
    line-height: 1.55;
    color: #b4bcd0;
    margin: 0 0 0.625rem;
  }

  .ai-chip {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    font-size: 0.65rem;
    color: #e5d0ad;
    background: rgb(200 165 107 / 0.1);
    border: 1px solid rgb(200 165 107 / 0.3);
    border-radius: 100px;
    white-space: nowrap;
  }

  .ai-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #d9bc8a;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.4; transform: scale(0.8); }
    50% { opacity: 1; transform: scale(1.1); }
  }

  /* Features */
  .features { padding: 5rem 0; }

  .section-head {
    margin-bottom: 3rem;
    max-width: 50ch;
  }

  .section-head h2 {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.015em;
    margin: 0 0 0.5rem;
  }

  .section-head p {
    color: var(--color-text-dim);
    margin: 0;
    font-size: var(--text-base);
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 2rem 2.5rem;
  }

  .feature h3 {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 500;
    color: var(--color-text);
    margin: 0 0 0.5rem;
    letter-spacing: -0.01em;
  }

  .feature p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin: 0;
  }

  /* FAQ */
  .faq {
    padding: 5rem 0;
    background: color-mix(in oklab, var(--color-ink-900) 50%, var(--color-bg));
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .faq-list {
    max-width: 60ch;
  }

  .faq-list details {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .faq-list details:last-child { border-bottom: none; }

  .faq-list summary {
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-text);
    cursor: pointer;
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .faq-list summary::-webkit-details-marker { display: none; }

  .faq-list summary::after {
    content: '+';
    color: var(--color-gold-400);
    font-size: 1.5rem;
    transition: transform 150ms ease;
  }

  .faq-list details[open] summary::after { transform: rotate(45deg); }

  .faq-list p {
    color: var(--color-text-muted);
    font-size: var(--text-sm);
    line-height: 1.65;
    margin: 0.75rem 0 0;
  }

  /* Final CTA */
  .cta-section { padding: 5rem 0; }

  .cta-card {
    text-align: center;
    padding: 4rem 2rem;
    background: linear-gradient(135deg, var(--color-ink-900), var(--color-ink-800));
    border: 1px solid color-mix(in oklab, var(--color-gold-500) 20%, var(--color-border));
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
  }

  .cta-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at 50% 0%,
      color-mix(in oklab, var(--color-gold-500) 15%, transparent),
      transparent 60%
    );
    pointer-events: none;
  }

  .cta-card h2 {
    font-family: var(--font-serif);
    font-size: var(--text-3xl);
    font-weight: 500;
    color: var(--color-text);
    letter-spacing: -0.015em;
    max-width: 24ch;
    margin: 0 auto 2rem;
    position: relative;
  }

  .cta-card .btn { position: relative; }

  /* Tablet portrait + below — stack hero to single column before the
     mockup starts squeezing the heading. 820 px was late: iPad portrait
     (768 px) kept a 2-col layout with a cramped text column. */
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .phone-frame { width: 240px; }
    .features-grid { grid-template-columns: 1fr; gap: 1.75rem; }
  }

  @media (max-width: 640px) {
    .hero { padding: 2.5rem 0 1.5rem; }
    .features, .faq, .cta-section { padding: 3rem 0; }
    .cta-card { padding: 2.5rem 1.25rem; }
    .phone-frame { width: 200px; }
    /* CTA pair goes full-width stacked so each button is one clean tap
       target instead of wrapping into an awkward 2-row flex. */
    .cta-row { flex-direction: column; align-items: stretch; }
    .cta-row .btn { width: 100%; justify-content: center; }
    /* FAQ rows need a 44px touch target, not ~19px. */
    .faq-list summary { min-height: 44px; }
    .hero h1 { font-size: var(--text-3xl); }
    .cta-card h2 { font-size: var(--text-2xl); }
  }
</style>
